# Copia este archivo como .env y completa los datos de tu PC.
# El archivo .env no se sube a GitHub (está en .gitignore).

# Servidor de SQL Server: localhost, el nombre de tu PC o localhost\SQLEXPRESS
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BDGeolo
DB_DRIVER=ODBC Driver 18 for SQL Server

# Deja DB_USER vacío para usar la autenticación de Windows.
# Para usar el usuario sa, completa DB_USER y DB_PASSWORD.
DB_USER=
DB_PASSWORD=

# Clave para firmar las sesiones del login
SESSION_SECRET=cambia-esta-clave
